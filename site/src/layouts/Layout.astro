---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="IMS Games - Transparent Game Score Aggregator" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | IMS Games</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-bold text-xl text-ims-700 hover:text-ims-500 transition-colors">
          <span class="text-2xl">&#9670;</span> IMS Games
        </a>
        <div class="flex items-center gap-6 text-sm font-medium text-gray-600">
          <a href="/games" class="hover:text-ims-600 transition-colors">Games</a>
          <a href="/sources" class="hover:text-ims-600 transition-colors">Sources</a>
          <a href="/methodology" class="hover:text-ims-600 transition-colors">Methodology</a>
          <a href="/data-sources" class="hover:text-ims-600 transition-colors">Data Sources</a>
        </div>
      </nav>
    </header>

    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
      <slot />
    </main>

    <footer class="bg-white border-t border-gray-200 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 text-center text-sm text-gray-500">
        <p>IMS Games &mdash; Transparent, explainable, and extensible game score aggregation.</p>
        <p class="mt-1">Algorithm v0.1.0 &middot; All scores are computed with publicly documented rules.</p>
      </div>
    </footer>
  </body>
</html>
