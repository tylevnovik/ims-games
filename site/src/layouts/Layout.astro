---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="IMS Games - Transparent Game Score Aggregator" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title} | IMS Games</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
        <a href={base} class="flex items-center gap-2 font-bold text-xl text-ims-700 hover:text-ims-500 transition-colors">
          <span class="text-2xl">&#9670;</span> IMS Games
        </a>
        <!-- Hamburger button (mobile only) -->
        <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-600 hover:text-ims-600 transition-colors" aria-label="Toggle menu">
          <span class="text-2xl leading-none">&#9776;</span>
        </button>
        <!-- Desktop nav -->
        <div class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-600">
          <a href={`${base}/games`} data-i18n="nav.games" class="hover:text-ims-600 transition-colors">游戏库</a>
          <a href={`${base}/goat`} data-i18n="nav.goat" class="hover:text-ims-600 transition-colors">GOAT</a>
          <a href={`${base}/goty`} data-i18n="nav.goty" class="hover:text-ims-600 transition-colors">GOTY</a>
          <a href={`${base}/sources`} data-i18n="nav.sources" class="hover:text-ims-600 transition-colors">媒体源</a>
          <a href={`${base}/methodology`} data-i18n="nav.methodology" class="hover:text-ims-600 transition-colors">算法说明</a>
          <a href={`${base}/data-sources`} data-i18n="nav.data_sources" class="hover:text-ims-600 transition-colors">数据来源</a>
          <button id="lang-toggle" class="px-2 py-1 text-xs font-bold border border-gray-300 rounded hover:bg-gray-50 transition-colors">中</button>
        </div>
      </nav>
      <!-- Mobile nav drawer -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 bg-white">
        <div class="max-w-7xl mx-auto px-4 py-3 space-y-2 text-sm font-medium text-gray-600">
          <a href={`${base}/games`} data-i18n="nav.games" class="block py-2 hover:text-ims-600 transition-colors">游戏库</a>
          <a href={`${base}/goat`} data-i18n="nav.goat" class="block py-2 hover:text-ims-600 transition-colors">GOAT</a>
          <a href={`${base}/goty`} data-i18n="nav.goty" class="block py-2 hover:text-ims-600 transition-colors">GOTY</a>
          <a href={`${base}/sources`} data-i18n="nav.sources" class="block py-2 hover:text-ims-600 transition-colors">媒体源</a>
          <a href={`${base}/methodology`} data-i18n="nav.methodology" class="block py-2 hover:text-ims-600 transition-colors">算法说明</a>
          <a href={`${base}/data-sources`} data-i18n="nav.data_sources" class="block py-2 hover:text-ims-600 transition-colors">数据来源</a>
          <button id="lang-toggle-mobile" class="mt-1 px-2 py-1 text-xs font-bold border border-gray-300 rounded hover:bg-gray-50 transition-colors">中</button>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
      <slot />
    </main>

    <footer class="bg-white border-t border-gray-200 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 text-center text-sm text-gray-500">
        <p data-i18n="footer.tagline">IMS Games &mdash; 透明、可解释、可扩展的游戏评分聚合。</p>
        <p data-i18n="footer.version" class="mt-1">算法 v0.1.0 &middot; 所有分数均由公开文档化的规则计算。</p>
      </div>
    </footer>

    <script>
      (function () {
        var translations = {
          // Nav
          "nav.games": { zh: "游戏库", en: "Games" },
          "nav.sources": { zh: "媒体源", en: "Sources" },
          "nav.methodology": { zh: "算法说明", en: "Methodology" },
          "nav.data_sources": { zh: "数据来源", en: "Data Sources" },
          "nav.goat": { zh: "GOAT", en: "GOAT" },
          "nav.goty": { zh: "GOTY", en: "GOTY" },
          // Home
          "home.subtitle": { zh: "透明游戏评分", en: "Transparent Game Scores" },
          "home.description": { zh: "一个透明、可解释、可扩展的游戏评分聚合系统。不同于黑箱评分，IMS Games 的每个分数都基于公开文档化的规则计算，您可以自定义权重以匹配您的偏好。", en: "A transparent, explainable, and extensible game score aggregation system. Unlike black-box scores, every IMS Games score is computed with publicly documented rules and you can customize the weighting to match your preferences." },
          "home.stats.games": { zh: "收录游戏", en: "Games in Database" },
          "home.stats.sources": { zh: "媒体来源", en: "Media Sources" },
          "home.stats.reviews": { zh: "收录评论", en: "Reviews Collected" },
          "home.top_games": { zh: "高分游戏", en: "Top Rated Games" },
          "home.view_all": { zh: "查看全部 \u2192", en: "View all \u2192" },
          "home.no_data": { zh: "暂无游戏数据。请运行数据管线生成评分。", en: "No game data available. Please run the data pipeline to generate scores." },
          "home.card.methodology": { zh: "算法与方法论", en: "Algorithm & Methodology" },
          "home.card.methodology_desc": { zh: "了解 IMS 原始分、稳健分、校准分和加权分的计算方式。所有规则均公开文档化。", en: "Learn how IMS Raw, Robust, Calibrated, and Weighted scores are calculated. Every rule is publicly documented." },
          "home.card.data_sources": { zh: "数据来源与授权", en: "Data Sources & Licensing" },
          "home.card.data_sources_desc": { zh: "了解我们的数据来源、采集方式以及署名与授权策略。", en: "See where our data comes from, how it\u2019s collected, and our approach to attribution and licensing." },
          // Shared table headers
          "col.rank": { zh: "#", en: "#" },
          "col.game": { zh: "游戏", en: "Game" },
          "col.metacritic": { zh: "Metacritic", en: "Metacritic" },
          "col.ims_raw": { zh: "IMS 原始分", en: "IMS Raw" },
          "col.ims_weighted": { zh: "IMS 加权分", en: "IMS Weighted" },
          "col.reviews": { zh: "评论数", en: "Reviews" },
          // Methodology page
          "methodology.title": { zh: "算法与方法论", en: "Algorithm & Methodology" },
          "methodology.data_sources": { zh: "数据来源", en: "Data Sources" },
          "methodology.data_sources_desc": { zh: "IMS Games 从多个透明来源聚合评论：", en: "IMS Games aggregates reviews from multiple transparent sources:" },
          "methodology.ds.kaggle": { zh: "Metacritic Kaggle 数据集 \u2014 12,000+ 款游戏的历史媒体评分", en: "Metacritic Kaggle Dataset \u2014 12,000+ games with historical critic review scores" },
          "methodology.ds.opencritic": { zh: "OpenCritic \u2014 官方 API 或公开网页快照，提供含媒体信息的独立评论", en: "OpenCritic \u2014 official API or public web snapshots providing individual critic reviews with outlet info" },
          "methodology.ds.future": { zh: "未来来源：Steam 评论、IGDB、中文游戏媒体、视频评论者", en: "Future sources: Steam reviews, IGDB, Chinese gaming media, video reviewers" },
          "methodology.normalization": { zh: "分数归一化", en: "Score Normalization" },
          "methodology.normalization_desc": { zh: "所有分数均通过文档化规则转换为统一的 0\u2013100 量表：", en: "All scores are converted to a uniform 0\u2013100 scale using documented rules:" },
          "methodology.normalization_note": { zh: "非数字评分（如\u201c推荐\u201d）不计入数字平均值。", en: "Non-numeric scores (e.g., \u201cRecommended\u201d) are excluded from numeric averages." },
          "methodology.score_types": { zh: "分数类型", en: "Score Types" },
          "methodology.score.raw": { zh: "IMS 原始分", en: "IMS Raw Score" },
          "methodology.score.raw_desc": { zh: "所有有效归一化评论分数的简单平均。", en: "Simple average of all valid normalized review scores. mean(normalized_score)" },
          "methodology.score.median": { zh: "IMS 中位数分", en: "IMS Median Score" },
          "methodology.score.median_desc": { zh: "所有归一化分数的中位数，对异常值不那么敏感。", en: "Median of all normalized scores. Less sensitive to outliers." },
          "methodology.score.robust": { zh: "IMS 稳健分", en: "IMS Robust Score" },
          "methodology.score.robust_desc": { zh: "截尾均值：去除最高 5% 和最低 5% 的分数后取平均（需 \u226520 条评论）。", en: "Trimmed mean: removes top 5% and bottom 5% of scores before averaging (requires \u226520 reviews)." },
          "methodology.score.calibrated": { zh: "IMS 校准分", en: "IMS Calibrated Score" },
          "methodology.score.calibrated_desc": { zh: "根据每个媒体的历史评分倾向进行调整。一贯打高分的媒体会被下调；严格的媒体会被上调。使用 z-score 校准：calibrated = global_mean + z \u00d7 global_std", en: "Adjusts for each source\u2019s historical scoring tendency. A source that always scores high gets downward-adjusted; a strict source gets upward-adjusted. Uses z-score calibration: calibrated = global_mean + z \u00d7 global_std" },
          "methodology.score.weighted": { zh: "IMS 加权分", en: "IMS Weighted Score" },
          "methodology.score.weighted_desc": { zh: "使用透明的媒体权重进行加权平均。权重考虑样本量、区分度、类型/平台相关性和披露完整度。", en: "Weighted average using transparent source weights. Weights consider sample size, discrimination power, genre/platform relevance, and disclosure completeness." },
          "methodology.weight_formula": { zh: "媒体权重公式", en: "Media Weight Formula" },
          "methodology.weight_formula_desc": { zh: "每个媒体的权重计算方式：", en: "Each source\u2019s weight is computed as:" },
          "methodology.weight.component": { zh: "组件", en: "Component" },
          "methodology.weight.range": { zh: "范围", en: "Range" },
          "methodology.weight.description": { zh: "说明", en: "Description" },
          "methodology.weight.base_weight": { zh: "所有媒体的起始权重", en: "Starting weight for all sources" },
          "methodology.weight.sample_confidence": { zh: "历史评论越多，置信度越高", en: "More historical reviews = higher confidence" },
          "methodology.weight.discrimination_factor": { zh: "评分方差越大的媒体权重越高", en: "Sources with more score variance get higher weight" },
          "methodology.weight.genre_relevance": { zh: "该游戏类型的评论越多，相关性越高", en: "More reviews in the game\u2019s genre = higher relevance" },
          "methodology.weight.platform_relevance": { zh: "该游戏平台的评论越多，相关性越高", en: "More reviews on the game\u2019s platform = higher relevance" },
          "methodology.weight.disclosure_factor": { zh: "评测码/赞助披露略微提升权重", en: "Review code/sponsorship disclosure slightly boosts weight" },
          "methodology.external_baseline": { zh: "外部基准 vs IMS 评分", en: "External Baseline vs IMS Scores" },
          "methodology.external_baseline_desc": { zh: "Metacritic 和 OpenCritic 分数仅作为外部基准参考显示。它们不会混入 IMS 算法分数。页面明确区分了外部参考分数和 IMS 透明分数。", en: "Metacritic and OpenCritic scores are displayed as external baselines only. They are never mixed into IMS algorithm scores. The page clearly distinguishes between external reference scores and IMS transparent scores." },
          "methodology.limitations": { zh: "已知局限（v0.1）", en: "Known Limitations (v0.1)" },
          "methodology.limit.genre_platform": { zh: "许多老游戏的类型和平台数据不完整", en: "Genre and platform data is incomplete for many older games" },
          "methodology.limit.letter_grade": { zh: "字母等级转换使用固定映射", en: "Letter grade conversions use a fixed mapping" },
          "methodology.limit.calibration": { zh: "校准需要每个来源 \u226510 条评论", en: "Calibration requires \u226510 reviews per source" },
          "methodology.limit.formulas": { zh: "权重组件使用简化公式；未来版本可能使用更复杂的模型", en: "Weight components use simplified formulas; future versions may use more sophisticated models" },
          "methodology.limit.video_chinese": { zh: "视频创作者和中文媒体尚未纳入", en: "Video creators and Chinese media are not yet included" },
          // Data sources page
          "data_sources.title": { zh: "数据来源与授权", en: "Data Sources & Licensing" },
          "data_sources.kaggle": { zh: "Kaggle Metacritic 数据集", en: "Kaggle Metacritic Dataset" },
          "data_sources.kaggle_desc": { zh: "游戏元数据和媒体评分的主要数据来源。此开放数据集包含约 321,000 条评论记录，涵盖 12,000+ 款游戏、500+ 家媒体。", en: "The primary data source for game metadata and critic review scores. This open dataset contains approximately 321,000 individual review entries across 12,000+ games from 500+ media outlets." },
          "data_sources.kaggle.contains": { zh: "包含：游戏标题、媒体名称、评论摘要、数字评分", en: "Contains: game titles, media outlet names, review text excerpts, numeric scores" },
          "data_sources.kaggle.not_contains": { zh: "不包含：完整评论文章、评论者姓名、评论链接", en: "Does NOT contain: full review articles, reviewer names, review URLs" },
          "data_sources.kaggle.source": { zh: "原始来源：Kaggle（公开可用数据集）", en: "Original source: Kaggle (publicly available dataset)" },
          "data_sources.kaggle.license": { zh: "许可：用于研究的公开数据集", en: "License: Public dataset for research use" },
          "data_sources.opencritic": { zh: "OpenCritic 数据", en: "OpenCritic Data" },
          "data_sources.opencritic_desc": { zh: "用于增强评论级别数据，包含独立评论、媒体信息、评论日期和评论链接；当前用于补齐 2024\u20132026 以及旧年份低样本游戏。默认不使用模拟数据。", en: "Used for enhanced review-level data with individual critic reviews, outlet information, review dates, and review links; currently backfills 2024\u20132026 and older low-sample games. Mock data is disabled by default." },
          "data_sources.opencritic.api": { zh: "优先使用官方 API；没有 API 导出时，可用公开网页快照做静态回填", en: "Prefer the official API; public web snapshots can be used for static backfills when no API export is available" },
          "data_sources.opencritic.mock": { zh: "模拟数据仅用于本地概念验证，不参与默认构建", en: "Mock data is only for local proof-of-concept runs and is excluded from default builds" },
          "data_sources.opencritic.provenance": { zh: "每条评论保留来源链接用于署名", en: "Each review retains its provenance URL for attribution" },
          "data_sources.practices": { zh: "数据实践", en: "Our Data Practices" },
          "data_sources.practices.store": { zh: "我们存储的内容：结构化字段（评分、日期、平台、语言）、简短摘要及原始评论链接。", en: "What we store: Structured fields (scores, dates, platform, language), short summaries, and links to original reviews." },
          "data_sources.practices.not_store": { zh: "我们不存储的内容：完整的受版权保护的评论文本。仅存储结构化数据和简短摘录。", en: "What we don\u2019t store: Full copyrighted review text. Only structured data and brief excerpts." },
          "data_sources.practices.attribution": { zh: "署名：每条评论记录保留指向原始来源的来源链接。原始评分归属于相应媒体。", en: "Attribution: Every review entry retains a provenance URL linking to the original source. Original scores are credited to their respective outlets." },
          "data_sources.practices.purpose": { zh: "用途：本网站仅用于研究、演示和评分聚合实验。", en: "Purpose: This site is for research, demonstration, and score aggregation experiments only." },
          "data_sources.practices.freshness": { zh: "数据时效：数据采集和处理时间为此前某个日期。这是一个静态快照，非实时更新。", en: "Data freshness: Data was collected and processed at a previous date. This is a static snapshot, not a live feed." },
          "data_sources.copyright": { zh: "版权声明", en: "Copyright Notice" },
          "data_sources.copyright_desc": { zh: "所有评论内容、评分和元数据归属于各自的所有者。IMS Games 仅存储结构化数据和简短摘录用于聚合目的。完整评论内容可在原始来源链接处获取。本项目与 Metacritic、OpenCritic 或任何游戏发行商无关。", en: "All review content, scores, and metadata belong to their respective owners. IMS Games only stores structured data and brief excerpts for aggregation purposes. Full review content is available at the original source URLs. This project is not affiliated with Metacritic, OpenCritic, or any game publisher." },
          // Sources list
          "sources.title": { zh: "媒体源", en: "Media Sources" },
          "sources.description": { zh: "IMS Games 收录的所有评论媒体及其历史表现指标。", en: "All review sources tracked by IMS Games, with historical performance metrics." },
          "sources.col.name": { zh: "来源", en: "Source" },
          "sources.col.type": { zh: "类型", en: "Type" },
          "sources.col.language": { zh: "语言", en: "Language" },
          "sources.col.region": { zh: "地区", en: "Region" },
          "sources.col.reviews": { zh: "评论数", en: "Reviews" },
          "sources.col.avg_score": { zh: "平均分", en: "Avg Score" },
          "sources.col.weight": { zh: "权重", en: "Weight" },
          "sources.total": { zh: "个媒体源", en: "sources total" },
          // Games list
          "games.title": { zh: "游戏库", en: "Game Library" },
          // GOAT page
          "goat.subtitle": { zh: "史上最伟大游戏", en: "Greatest of All Time" },
          "goat.page_desc": { zh: "基于 IMS 加权分数排名，选出数据库中最伟大的游戏。", en: "Ranked by IMS Weighted Score — the greatest games in our database." },
          // GOTY page
          "goty.subtitle": { zh: "年度游戏", en: "Game of the Year" },
          "goty.page_desc": { zh: "对比 The Game Awards、BAFTA、GDC 三大颁奖典礼的年度游戏得主，以及 IMS 评分的年度最佳。", en: "Compare Game of the Year winners from The Game Awards, BAFTA, and GDC with IMS score rankings." },
          // Footer
          "footer.tagline": { zh: "IMS Games \u2014 透明、可解释、可扩展的游戏评分聚合。", en: "IMS Games \u2014 Transparent, explainable, and extensible game score aggregation." },
          "footer.version": { zh: "算法 v0.1.0 \u00b7 所有分数均由公开文档化的规则计算。", en: "Algorithm v0.1.0 \u00b7 All scores are computed with publicly documented rules." },
        };

        function getLang() {
          return localStorage.getItem("ims-lang") || "zh";
        }

        function applyTranslations(lang) {
          var elements = document.querySelectorAll("[data-i18n]");
          for (var i = 0; i < elements.length; i++) {
            var key = elements[i].getAttribute("data-i18n");
            if (translations[key] && translations[key][lang] !== undefined) {
              elements[i].textContent = translations[key][lang];
            }
          }
        }

        function updateToggle(lang) {
          var btn = document.getElementById("lang-toggle");
          if (btn) {
            btn.textContent = lang === "zh" ? "中" : "EN";
          }
        }

        function updateHtmlLang(lang) {
          document.documentElement.lang = lang;
        }

        // Initialize on load
        var currentLang = getLang();
        applyTranslations(currentLang);
        updateToggle(currentLang);
        updateHtmlLang(currentLang);

        // Toggle button click
        var toggleBtn = document.getElementById("lang-toggle");
        if (toggleBtn) {
          toggleBtn.addEventListener("click", function () {
            var newLang = getLang() === "zh" ? "en" : "zh";
            localStorage.setItem("ims-lang", newLang);
            applyTranslations(newLang);
            updateToggle(newLang);
            updateHtmlLang(newLang);
            window.dispatchEvent(
              new CustomEvent("ims-lang-change", { detail: newLang })
            );
          });
        }

        // Mobile hamburger menu toggle
        var menuBtn = document.getElementById("mobile-menu-btn");
        var mobileMenu = document.getElementById("mobile-menu");
        if (menuBtn && mobileMenu) {
          menuBtn.addEventListener("click", function () {
            mobileMenu.classList.toggle("hidden");
          });
        }

        // Mobile lang toggle (sync with desktop)
        var mobileToggleBtn = document.getElementById("lang-toggle-mobile");
        if (mobileToggleBtn) {
          // Sync initial text
          mobileToggleBtn.textContent = getLang() === "zh" ? "\u4E2D" : "EN";
          mobileToggleBtn.addEventListener("click", function () {
            var newLang = getLang() === "zh" ? "en" : "zh";
            localStorage.setItem("ims-lang", newLang);
            applyTranslations(newLang);
            updateToggle(newLang);
            mobileToggleBtn.textContent = newLang === "zh" ? "\u4E2D" : "EN";
            updateHtmlLang(newLang);
            window.dispatchEvent(
              new CustomEvent("ims-lang-change", { detail: newLang })
            );
          });
        }

        // Listen for lang changes to sync mobile toggle
        window.addEventListener("ims-lang-change", function (e) {
          var lang = e.detail;
          var mt = document.getElementById("lang-toggle-mobile");
          if (mt) mt.textContent = lang === "zh" ? "\u4E2D" : "EN";
        });

        // Listen for lang changes from other sources
        window.addEventListener("ims-lang-change", function (e) {
          var lang = e.detail;
          applyTranslations(lang);
          updateToggle(lang);
          updateHtmlLang(lang);
        });
      })();
    </script>
  </body>
</html>
