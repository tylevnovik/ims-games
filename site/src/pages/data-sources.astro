---
import Layout from "../layouts/Layout.astro";
import fs from "node:fs";
import path from "node:path";

let meta: any = {};
const metaPath = path.join(process.cwd(), "public", "data", "meta.json");
if (fs.existsSync(metaPath)) {
  meta = JSON.parse(fs.readFileSync(metaPath, "utf-8"));
}
---

<Layout title="数据来源">
  <h1 class="text-3xl font-bold text-gray-900 mb-6" data-i18n="data_sources.title">数据来源与授权</h1>

  <div class="space-y-6">
    <section class="bg-white rounded-xl border border-gray-200 p-6">
      <h2 class="text-xl font-bold mb-3" data-i18n="data_sources.kaggle">Kaggle Metacritic 数据集</h2>
      <p class="text-gray-600 mb-2" data-i18n="data_sources.kaggle_desc">
        游戏元数据和媒体评分的主要数据来源。此开放数据集
        包含约 321,000 条评论记录，涵盖 12,000+ 款游戏、500+ 家媒体。
      </p>
      <ul class="list-disc pl-6 text-gray-600 text-sm space-y-1">
        <li data-i18n="data_sources.kaggle.contains">包含：游戏标题、媒体名称、评论摘要、数字评分</li>
        <li data-i18n="data_sources.kaggle.not_contains">不包含：完整评论文章、评论者姓名、评论链接</li>
        <li data-i18n="data_sources.kaggle.source">原始来源：Kaggle（公开可用数据集）</li>
        <li data-i18n="data_sources.kaggle.license">授权：用于研究的公开数据集</li>
      </ul>
    </section>

    <section class="bg-white rounded-xl border border-gray-200 p-6">
      <h2 class="text-xl font-bold mb-3" data-i18n="data_sources.opencritic">OpenCritic 数据</h2>
      <p class="text-gray-600 mb-2" data-i18n="data_sources.opencritic_desc">
        用于增强评论级别数据，包含独立评论、媒体信息、评论日期和评论链接；
        当前用于补齐 2024–2026 以及 2010–2023 低样本游戏。默认不使用模拟数据。
      </p>
      <ul class="list-disc pl-6 text-gray-600 text-sm space-y-1">
        <li data-i18n="data_sources.opencritic.api">优先使用官方 API；没有 API 导出时，可用公开网页快照做静态回填</li>
        <li data-i18n="data_sources.opencritic.mock">模拟数据仅用于本地概念验证，不参与默认构建</li>
        <li data-i18n="data_sources.opencritic.provenance">每条评论保留来源链接用于署名</li>
      </ul>
    </section>

    <section class="bg-white rounded-xl border border-gray-200 p-6">
      <h2 class="text-xl font-bold mb-3" data-i18n="data_sources.practices">数据实践</h2>
      <div class="space-y-3 text-gray-600 text-sm">
        <p data-i18n="data_sources.practices.store"><strong>我们存储的内容：</strong>结构化字段（评分、日期、平台、语言）、简短摘要及原始评论链接。</p>
        <p data-i18n="data_sources.practices.not_store"><strong>我们不存储的内容：</strong>完整的受版权保护的评论文本。仅存储结构化数据和简短摘录。</p>
        <p data-i18n="data_sources.practices.attribution"><strong>署名：</strong>每条评论记录保留指向原始来源的来源链接。原始评分归属于相应媒体。</p>
        <p data-i18n="data_sources.practices.purpose"><strong>用途：</strong>本网站仅用于研究、演示和评分聚合实验。</p>
        <p data-i18n="data_sources.practices.freshness"><strong>数据时效：</strong>数据采集和处理时间为 {meta.build_timestamp ? new Date(meta.build_timestamp).toLocaleDateString() : "此前某个日期"}。这是一个静态快照，非实时更新。</p>
      </div>
    </section>

    <section class="bg-amber-50 rounded-xl border border-amber-200 p-6">
      <h2 class="text-xl font-bold text-amber-800 mb-2" data-i18n="data_sources.copyright">版权声明</h2>
      <p class="text-amber-700 text-sm" data-i18n="data_sources.copyright_desc">
        所有评论内容、评分和元数据归属于各自的所有者。
        IMS Games 仅存储结构化数据和简短摘录用于聚合目的。
        完整评论内容可在原始来源链接处获取。
        本项目与 Metacritic、OpenCritic 或任何游戏发行商无关。
      </p>
    </section>
  </div>
</Layout>
