---
import Layout from "../../layouts/Layout.astro";
import GameList from "../../components/GameList";
import fs from "node:fs";
import path from "node:path";

let games: any[] = [];
const gamesPath = path.join(process.cwd(), "public", "data", "games.json");
if (fs.existsSync(gamesPath)) {
  games = JSON.parse(fs.readFileSync(gamesPath, "utf-8"));
}
---

<Layout title="游戏库">
  <h1 class="text-3xl font-bold text-gray-900 mb-6" data-i18n="games.title">游戏库</h1>
  <GameList client:load games={games} />
</Layout>
