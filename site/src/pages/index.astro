---
import Layout from "../layouts/Layout.astro";

let meta = { total_games: 0, total_sources: 0, total_reviews: 0, algorithm_version: "0.1.0", data_sources: [] };
let topGames: any[] = [];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

try {
  const metaRes = await fetch(new URL("../../public/data/meta.json", import.meta.url), { priority: "high" }).catch(() => null);
  if (metaRes) {
    const text = await metaRes.text();
    meta = JSON.parse(text);
  }
} catch { /* use defaults */ }

try {
  const fs = await import("node:fs");
  const path = await import("node:path");
  const metaPath = path.join(process.cwd(), "public", "data", "meta.json");
  if (fs.existsSync(metaPath)) {
    meta = JSON.parse(fs.readFileSync(metaPath, "utf-8"));
  }
  const gamesPath = path.join(process.cwd(), "public", "data", "games.json");
  if (fs.existsSync(gamesPath)) {
    const games = JSON.parse(fs.readFileSync(gamesPath, "utf-8"));
    topGames = games
      .filter((g: any) => g.ims_weighted != null)
      .sort((a: any, b: any) => b.ims_weighted - a.ims_weighted)
      .slice(0, 10);
  }
} catch { /* static build fallback */ }
---

<Layout title="首页">
  <section class="text-center mb-12">
    <h1 class="text-2xl sm:text-4xl font-bold text-gray-900 mb-4">
      <span class="text-ims-600">IMS Games</span> &mdash; <span data-i18n="home.subtitle">透明游戏评分</span>
    </h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto" data-i18n="home.description">
      一个透明、可解释、可扩展的游戏评分聚合系统。
      不同于黑箱评分，IMS Games 的每个分数都基于公开文档化的规则计算，
      您可以自定义权重以匹配您的偏好。
    </p>
  </section>

  <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    <div class="bg-white rounded-xl border border-gray-200 p-6 text-center">
      <div class="text-3xl font-bold text-ims-600">{meta.total_games.toLocaleString()}</div>
      <div class="text-sm text-gray-500 mt-1" data-i18n="home.stats.games">收录游戏</div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-6 text-center">
      <div class="text-3xl font-bold text-ims-600">{meta.total_sources.toLocaleString()}</div>
      <div class="text-sm text-gray-500 mt-1" data-i18n="home.stats.sources">媒体来源</div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-6 text-center">
      <div class="text-3xl font-bold text-ims-600">{meta.total_reviews.toLocaleString()}</div>
      <div class="text-sm text-gray-500 mt-1" data-i18n="home.stats.reviews">收录评论</div>
    </div>
  </section>

  <section class="mb-12">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-2xl font-bold text-gray-800" data-i18n="home.top_games">高分游戏</h2>
      <a href={`${base}/games`} class="text-sm text-ims-600 hover:text-ims-500 font-medium" data-i18n="home.view_all">查看全部 &rarr;</a>
    </div>
    {topGames.length > 0 ? (
      <div class="bg-white rounded-xl border border-gray-200 overflow-x-auto">
        <table id="top-games-table" class="w-full text-sm">
          <thead class="bg-gray-50 text-gray-600 text-left">
            <tr>
              <th class="px-4 py-3 font-medium cursor-pointer select-none hover:text-ims-600" data-col="0" data-type="number"><span data-i18n="col.rank">#</span> <span class="sort-icon text-gray-400 ml-1"></span></th>
              <th class="px-4 py-3 font-medium cursor-pointer select-none hover:text-ims-600" data-col="1" data-type="string"><span data-i18n="col.game">游戏</span> <span class="sort-icon text-gray-400 ml-1"></span></th>
              <th class="px-4 py-3 font-medium cursor-pointer select-none hover:text-ims-600 text-right" data-col="2" data-type="number"><span data-i18n="col.metacritic">Metacritic</span> <span class="sort-icon text-gray-400 ml-1"></span></th>
              <th class="px-4 py-3 font-medium cursor-pointer select-none hover:text-ims-600 text-right" data-col="3" data-type="number"><span data-i18n="col.ims_raw">IMS 原始分</span> <span class="sort-icon text-gray-400 ml-1"></span></th>
              <th class="px-4 py-3 font-medium cursor-pointer select-none hover:text-ims-600 text-right" data-col="4" data-type="number"><span data-i18n="col.ims_weighted">IMS 加权分</span> <span class="sort-icon text-gray-400 ml-1"></span></th>
              <th class="px-4 py-3 font-medium cursor-pointer select-none hover:text-ims-600 text-right" data-col="5" data-type="number"><span data-i18n="col.reviews">评论数</span> <span class="sort-icon text-gray-400 ml-1"></span></th>
            </tr>
          </thead>
          <tbody>
            {topGames.map((game: any, i: number) => (
              <tr class="border-t border-gray-100 hover:bg-gray-50" data-values={`${i + 1}|${game.title}|${game.metacritic_score ?? -1}|${game.ims_raw ?? -1}|${game.ims_weighted ?? -1}|${game.review_count}`}>
                <td class="px-4 py-3 text-gray-400">{i + 1}</td>
                <td class="px-4 py-3">
                  <a href={`${base}/games/${game.game_id}`} class="text-ims-700 hover:text-ims-500 font-medium">
                    {game.title}
                  </a>
                  {game.release_year && <span class="text-gray-400 ml-1">({game.release_year})</span>}
                </td>
                <td class="px-4 py-3 text-right font-mono">{game.metacritic_score != null ? game.metacritic_score.toFixed(1) : "N/A"}</td>
                <td class="px-4 py-3 text-right font-mono">{game.ims_raw != null ? game.ims_raw.toFixed(1) : "N/A"}</td>
                <td class="px-4 py-3 text-right font-mono font-bold text-ims-700">{game.ims_weighted != null ? game.ims_weighted.toFixed(1) : "N/A"}</td>
                <td class="px-4 py-3 text-right text-gray-500">{game.review_count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="bg-white rounded-xl border border-gray-200 p-8 text-center text-gray-500">
        <p data-i18n="home.no_data">暂无游戏数据。请运行数据管线生成评分。</p>
        <code class="text-xs mt-2 block text-gray-400">cd scripts && uv run python build_all.py</code>
      </div>
    )}
  </section>

  <section class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <a href={`${base}/methodology`} class="bg-white rounded-xl border border-gray-200 p-6 hover:border-ims-300 hover:shadow-sm transition-all">
      <h3 class="text-lg font-bold text-gray-800 mb-2" data-i18n="home.card.methodology">算法与方法论</h3>
      <p class="text-sm text-gray-600" data-i18n="home.card.methodology_desc">
        了解 IMS 原始分、稳健分、校准分和加权分的计算方式。所有规则均公开文档化。
      </p>
    </a>
    <a href={`${base}/data-sources`} class="bg-white rounded-xl border border-gray-200 p-6 hover:border-ims-300 hover:shadow-sm transition-all">
      <h3 class="text-lg font-bold text-gray-800 mb-2" data-i18n="home.card.data_sources">数据来源与授权</h3>
      <p class="text-sm text-gray-600" data-i18n="home.card.data_sources_desc">
        了解我们的数据来源、采集方式以及署名与授权策略。
      </p>
    </a>
  </section>

  <script>
    (function () {
      var table = document.getElementById("top-games-table");
      if (!table) return;
      var tbody = table.querySelector("tbody");
      var rows = Array.from(tbody.querySelectorAll("tr"));
      var headers = table.querySelectorAll("th[data-col]");
      var currentSort = { col: 4, asc: false };

      function updateIcons() {
        headers.forEach(function (h) {
          var icon = h.querySelector(".sort-icon");
          if (icon) icon.textContent = "";
        });
        var active = table.querySelector('th[data-col="' + currentSort.col + '"] .sort-icon');
        if (active) active.textContent = currentSort.asc ? "\u25B2" : "\u25BC";
      }
      updateIcons();

      headers.forEach(function (th) {
        th.addEventListener("click", function () {
          var col = parseInt(th.getAttribute("data-col"));
          var type = th.getAttribute("data-type");
          var asc = currentSort.col === col ? !currentSort.asc : (type === "number" ? false : true);
          currentSort = { col: col, asc: asc };

          rows.sort(function (a, b) {
            var va = a.getAttribute("data-values").split("|")[col];
            var vb = b.getAttribute("data-values").split("|")[col];
            if (type === "number") {
              va = parseFloat(va) || -1;
              vb = parseFloat(vb) || -1;
              return asc ? va - vb : vb - va;
            }
            return asc ? va.localeCompare(vb) : vb.localeCompare(va);
          });

          rows.forEach(function (row, idx) {
            row.querySelector("td:first-child").textContent = idx + 1;
            tbody.appendChild(row);
          });
          updateIcons();
        });
      });
    })();
  </script>
</Layout>
