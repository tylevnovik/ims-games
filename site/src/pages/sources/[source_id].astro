---
import Layout from "../../layouts/Layout.astro";
import SourceDetailClient from "../../components/SourceDetailClient";
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  const dir = path.join(process.cwd(), "public", "data", "sources");
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir)
    .filter((f: string) => f.endsWith(".json"))
    .map((f: string) => ({
      params: { source_id: f.replace(".json", "") },
    }));
}

const { source_id } = Astro.params;
const filePath = path.join(process.cwd(), "public", "data", "sources", `${source_id}.json`);
const source = JSON.parse(fs.readFileSync(filePath, "utf-8"));
---

<Layout title={source.name}>
  <SourceDetailClient client:load source={source} />
</Layout>
