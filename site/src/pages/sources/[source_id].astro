---
import Layout from "../../layouts/Layout.astro";
import SourceDetailClient from "../../components/SourceDetailClient";
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  const dir = path.join(process.cwd(), "public", "data", "sources");
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir)
    .filter((f: string) => f.endsWith(".json"))
    .map((f: string) => {
      const id = f.replace(".json", "");
      let title = id;
      try {
        const data = JSON.parse(fs.readFileSync(path.join(dir, f), "utf-8"));
        title = data.name || id;
      } catch {}
      return { params: { source_id: id }, props: { title } };
    });
}

const { source_id } = Astro.params;
const { title } = Astro.props;
---

<Layout title={title}>
  <SourceDetailClient client:load sourceId={source_id} />
</Layout>
