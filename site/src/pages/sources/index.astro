---
import Layout from "../../layouts/Layout.astro";
import fs from "node:fs";
import path from "node:path";

let sources: any[] = [];
const sourcesPath = path.join(process.cwd(), "public", "data", "sources.json");
if (fs.existsSync(sourcesPath)) {
  sources = JSON.parse(fs.readFileSync(sourcesPath, "utf-8"));
}
---

<Layout title="媒体源">
  <h1 class="text-3xl font-bold text-gray-900 mb-2" data-i18n="sources.title">媒体源</h1>
  <p class="text-gray-600 mb-6" data-i18n="sources.description">IMS Games 收录的所有评论媒体及其历史表现指标。</p>

  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-gray-600 text-left">
        <tr>
          <th class="px-4 py-3 font-medium" data-i18n="sources.col.name">来源</th>
          <th class="px-4 py-3 font-medium" data-i18n="sources.col.type">类型</th>
          <th class="px-4 py-3 font-medium" data-i18n="sources.col.language">语言</th>
          <th class="px-4 py-3 font-medium" data-i18n="sources.col.region">地区</th>
          <th class="px-4 py-3 font-medium text-right" data-i18n="sources.col.reviews">评论数</th>
          <th class="px-4 py-3 font-medium text-right" data-i18n="sources.col.avg_score">平均分</th>
          <th class="px-4 py-3 font-medium text-right" data-i18n="sources.col.weight">权重</th>
        </tr>
      </thead>
      <tbody>
        {sources.map((s: any) => (
          <tr class="border-t border-gray-100 hover:bg-gray-50">
            <td class="px-4 py-3">
              <a href={`${import.meta.env.BASE_URL}sources/${s.source_id}`} class="text-ims-700 hover:text-ims-500 font-medium">
                {s.name}
              </a>
            </td>
            <td class="px-4 py-3 text-gray-500">{s.source_type || "—"}</td>
            <td class="px-4 py-3 text-gray-500">{s.language || "—"}</td>
            <td class="px-4 py-3 text-gray-500">{s.country_region || "—"}</td>
            <td class="px-4 py-3 text-right text-gray-600">{s.review_count.toLocaleString()}</td>
            <td class="px-4 py-3 text-right font-mono">{s.mean_score != null ? s.mean_score.toFixed(1) : "N/A"}</td>
            <td class="px-4 py-3 text-right font-mono">{s.base_weight != null ? s.base_weight.toFixed(3) : "N/A"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="text-sm text-gray-400 mt-4"><span>{sources.length}</span> <span data-i18n="sources.total">个来源</span></p>
</Layout>
